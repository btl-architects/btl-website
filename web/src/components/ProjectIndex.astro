---
/* The index, shared by /projects and every category and place route.
 *
 * One component rather than a family of near-identical ones: the only thing
 * that varies between those routes is which projects are in the list and which
 * chip is current, so that is all this takes as props.
 */
import ProjectCard from "./ProjectCard.astro";
import { getEarnedCategories, getSettings, type Project } from "../lib/content";

interface Props {
  projects: Project[];
  active?: string;
  heading: string;
  /** What the page calls itself, large. Defaults to "Projects". */
  title?: string;
  /** The line under it. Defaults to the CMS's projects headline. */
  lead?: string;
}
const { projects, active = "", heading, title = "Projects", lead: leadProp } = Astro.props;

// Empty until the work earns it — see getEarnedCategories.
const chips = await getEarnedCategories();
const copy = (await getSettings()).copy;
const lead = leadProp ?? copy.projectsLead;
---

<main id="main" data-ground="dark" style="padding-top:var(--header-h)">
  {/* The index used to begin with a photograph hard against the header, which
      gave a visitor nothing to land on — the work started before the page had
      said what it was. A masthead costs one screen of scrolling and buys the
      reader a moment to arrive. */}
  <header class="index-head">
    <h1 class="index-head__t">{title}</h1>
    {lead && <p class="index-head__s">{lead}</p>}
  </header>

  {chips.length > 0 && (
    <nav class="chips" aria-label="Project categories">
      <a class="chip" href="/projects/" aria-current={active === "" ? "page" : undefined}>All</a>
      {chips.map((c) => (
        <a
          class="chip"
          href={`/projects/type/${c.slug}/`}
          aria-current={active === c.slug ? "page" : undefined}
        >{c.label}</a>
      ))}
    </nav>
  )}

  <div class="pindex" data-pindex>
    {projects.map((p, i) => (
      <ProjectCard project={p} index={i} priority={i === 0} />
    ))}
  </div>

  {/* Every other page ends by pointing somewhere. This one stopped dead. */}
  <div class="container">
    <a class="onward ul" href="/studio/">
      <span class="onward__k">Next</span>
      The practice behind the work.
    </a>
  </div>
</main>
