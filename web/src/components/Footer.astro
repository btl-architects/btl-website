---
/* One thin line, and nothing else.
 *
 * This used to open with a large "Let's build something that lasts." above a
 * row of social links, which meant every page — however short — ended with a
 * band of empty space and a second call to action the reader had not asked for.
 * On a page with four lines of text it was most of what you saw.
 *
 * The address, email and phone belong to Contact; the practice's own line
 * belongs on the pages that are actually saying something. What is left is the
 * minimum a footer owes anyone: who this is, where they are, and where to find
 * them.
 */
import type { Settings } from "../lib/content";

interface Props { settings: Settings; current?: string }
const { settings, current = "" } = Astro.props;
const year = new Date().getFullYear();

/* The home page already carries these down its right edge, fixed, for the whole
 * scroll. Printing them again at the foot of the same page is the reader being
 * told twice. So the footer carries them everywhere the rail does not, which is
 * one rule rather than a decision taken per page — and no page ends up without
 * a way to reach the practice elsewhere. */
const railCarriesSocial = current === "index";
---

<footer class="footer" data-ground="dark">
  {/* Two groups, because there are two kinds of thing here.
      The left is what this practice IS — name, place, domain. The right is
      where you can GO. They were one flat row of five items at identical
      spacing, with the social links carrying a "·" punctuation nothing else
      used, which is what made Privacy and the socials read as bolted on: they
      were formatted as an afterthought to a list of facts. Grouped, each half
      wraps as a unit and the pair sits at opposite ends of one line. */}
  <div class="container footer__base">
    <span class="footer__meta">
      <span>© {year} {settings.name}</span>
      <span>{settings.copy.locationLabel}</span>
      <span>{settings.domain}</span>
    </span>
    <span class="footer__links">
      <a class="tl" href="/privacy/">Privacy</a>
      {!railCarriesSocial && settings.social.map((s) => (
        <a class="tl" href={s.url} rel="noopener">{s.label}</a>
      ))}
    </span>
  </div>
</footer>
