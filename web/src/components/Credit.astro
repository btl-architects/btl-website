---
/* A Press entry owns its image. Older records can retain their project-photo
 * fallback. Complete client artwork keeps its full frame without another logo. */
import Figure from "./Figure.astro";
import type { Publication, Project } from "../lib/content";
import {articlePagePath, articleUrl} from "../lib/press";

interface Props { item: Publication; project?: Project }
const { item, project } = Astro.props;
const image = item.image ?? (item.useProjectImage ? project?.hook : null);
const custom = Boolean(item.image);

const original = articleUrl(item.url);
const reader = articlePagePath(item);
const live = Boolean(reader || original);
const Tag = live ? "a" : "div";
const year = item.date ? item.date.slice(0, 4) : "";

const meta = [item.kind === "award" ? "Award" : "Feature", project?.title, year]
  .filter(Boolean)
  .join(" · ");
---

<Tag
  class:list={["pc", custom && "pc--custom"]}
  href={reader || original || undefined}
  rel={live ? "noopener" : undefined}
  target={original && !reader ? "_blank" : undefined}
  data-article={reader ? "" : undefined}
  data-publication={reader ? item.publication : undefined}
  data-original={reader ? original : undefined}
  aria-haspopup={reader ? "dialog" : undefined}
  aria-label={`${item.publication} · ${meta}`}
>
  {/* Rendered even with nothing in it. One credit here — a Young Practice
      award — has no project behind it, and without the frame its card was
      shorter than its neighbour's and dragged that whole row's caption out of
      line. Empty it draws nothing; it just keeps the row straight. */}
  <span class="pc__img">
    {image && <Figure image={image} sizes="(min-width: 48rem) 26rem, 45vw" fit={custom ? "contain" : "cover"} />}
  </span>
  <span class="pc__m">{meta}</span>
</Tag>
