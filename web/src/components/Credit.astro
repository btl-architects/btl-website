---
/* One credit: the building, then who published it.
 *
 * This has been a card, then an index row, and is now a card again — which is
 * worth writing down, because the reasons the card failed the first time are
 * real and this shape only works because it avoids both of them.
 *
 * The first version floated the publication's mark ON the photograph. Matched
 * to a common height, "AD" measured 44x32 and "ArchDaily" 150x32 — the same
 * height and three and a half times the visual mass. That cannot be tuned away:
 * a two-letter monogram and a nine-letter word are not the same object, and
 * free on an image the difference shouts. Here the mark sits underneath, in its
 * own line of a text block, where marks of different lengths read as a list of
 * names of different lengths — which is what they are.
 *
 * The second was density: six tall cards left the page mostly empty and the
 * practice looking thinly published. These are wide rather than tall and run at
 * least two across, so six of them is a block of work rather than a long fall.
 *
 * The headline is gone at the practice's request. A credit is recognition, and
 * the recognition is the building plus the masthead; the article's own sentence
 * belongs to the article, one click away.
 */
import Figure from "./Figure.astro";
import Masthead from "./Masthead.astro";
import type { Publication, Project } from "../lib/content";

interface Props { item: Publication; project?: Project }
const { item, project } = Astro.props;

const live = !!item.url && item.url !== "#";
const Tag = live ? "a" : "div";
const year = item.date ? item.date.slice(0, 4) : "";

/* The photograph is the point, so a credit with no project behind it has
 * nothing to show and says so in type instead of leaving a grey rectangle. */
const meta = [item.kind === "award" ? "Award" : "Feature", project?.title, year]
  .filter(Boolean)
  .join(" · ");
---

<Tag
  class="pc"
  href={live ? item.url : undefined}
  rel={live ? "noopener" : undefined}
  target={live ? "_blank" : undefined}
>
  {/* Rendered even with nothing in it. One credit here — a Young Practice
      award — has no project behind it, and without the frame its card was
      shorter than its neighbour's and dragged that whole row's caption out of
      line. Empty it draws nothing; it just keeps the row straight. */}
  <span class="pc__img">
    {project && <Figure image={project.hook} sizes="(min-width: 60rem) 22rem, 45vw" />}
  </span>
  {/* The mark carries the height of a line so a monogram and a long wordmark
      leave the same gap above the meta line — the one part of the old card
      that was worth keeping. */}
  <span class="pc__mark"><Masthead item={item} /></span>
  <span class="pc__m">{meta}</span>
</Tag>
