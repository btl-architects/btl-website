---
/* A Press entry owns its image. Older records can retain their project-photo
 * fallback. Complete client artwork keeps its full frame without another logo. */
import Figure from "./Figure.astro";
import {resolveImage} from "../lib/media";
import type { Publication, Project } from "../lib/content";
import {articlePagePath, articleUrl} from "../lib/press";

interface Props { item: Publication; project?: Project }
const { item, project } = Astro.props;
const image = item.image ?? (item.useProjectImage ? project?.hook : null);
const custom = Boolean(item.image);
// The uploaded canvas can include off-centre photographs and lettering. The
// editor marks the photograph's centre with Sanity's existing image hotspot;
// only the caption follows it, while Figure retains the complete artwork.
const source = image?.source && typeof image.source === "object" ? image.source as {hotspot?: {x?: number}} : null;
const anchor = source?.hotspot?.x;
const originalCenter = typeof anchor === "number" && Number.isFinite(anchor) && anchor >= 0 && anchor <= 1 ? anchor : .5;
const bounds=custom ? image?.artworkBounds : undefined;
const center=bounds ? Math.max(0,Math.min(1,(originalCenter-bounds.left)/(1-bounds.left-bounds.right))) : originalCenter;
const fullImage = image && image.source && typeof image.source === "object"
  ? {...image, source: {...image.source, crop: bounds, hotspot: undefined}} : image;
const ratio = fullImage ? resolveImage(fullImage)?.ratio ?? 1 : 1;
// Custom frames are square; portrait artwork occupies ratio * frame width.
const captionOffset = custom ? (center - .5) * Math.min(1, ratio) * 200 : 0;

const original = articleUrl(item.url);
const reader = articlePagePath(item);
const live = Boolean(reader || original);
const Tag = live ? "a" : "div";
const year = item.date ? item.date.slice(0, 4) : "";

const meta = [item.kind === "award" ? "Award" : "Feature", project?.title, year]
  .filter(Boolean)
  .join(" · ");
---

<Tag
  class:list={["pc rv", custom && "pc--custom"]}
  href={reader || original || undefined}
  rel={live ? "noopener" : undefined}
  target={original && !reader ? "_blank" : undefined}
  data-article={reader ? "" : undefined}
  data-publication={reader ? item.publication : undefined}
  data-original={reader ? original : undefined}
  data-caption-anchor={custom ? center : undefined}
  aria-haspopup={reader ? "dialog" : undefined}
  aria-label={`${item.publication} · ${meta}`}
>
  {/* Rendered even with nothing in it. One credit here — a Young Practice
      award — has no project behind it, and without the frame its card was
      shorter than its neighbour's and dragged that whole row's caption out of
      line. Empty it draws nothing; it just keeps the row straight. */}
  <span class="pc__img">
    {image && <Figure image={image} sizes="(max-width: 47.99rem) min(45vw, 40svh), (max-width: 85.375rem) min(20rem, 34svh), min(26rem, 40svh)" fit={custom ? "contain" : "cover"} />}
  </span>
  <span class="pc__m" style={captionOffset ? `--caption-offset:${captionOffset.toFixed(4)}%;` : undefined}>{meta}</span>
</Tag>
