---
/* Press is a typographic index, not a simulated magazine.
 *
 * Simulating spreads out of project photography was the wrong idea twice over:
 * it read as decoration rather than evidence, and the "pages" were never pages.
 * What a press page is actually for is the mastheads — so the mastheads are the
 * composition. Publication set at display scale, the headline underneath it, the
 * year alone in the margin.
 *
 * Where a logo is missing — and today all of them are — the name set
 * typographically IS the design, not a degraded version of it. When real assets
 * arrive they become the hover state and nothing here has to move.
 */
import type { Publication } from "../lib/content";

interface Props { items: Publication[]; compact?: boolean }
const { items, compact = false } = Astro.props;

const yearOf = (date: string) => (date ? date.trim().split(/\s+/).pop()! : "—");
const isLive = (url: string) => !!url && url !== "#";
---

<ol class:list={["pi", compact && "pi--compact"]}>
  {items.map((item, i) => {
    const placeholder = item.publication === "PLACEHOLDER";
    const live = isLive(item.url);
    const Tag = live ? "a" : "div";
    return (
      <li class="pi__row rv" data-delay={i % 4}>
        <Tag
          class="pi__link"
          href={live ? item.url : undefined}
          rel={live ? "noopener" : undefined}
          target={live ? "_blank" : undefined}
        >
          <span class="pi__n">{String(i + 1).padStart(2, "0")}</span>
          <span class="pi__body">
            <span class:list={["pi__pub", placeholder && "pi__pub--tbc"]}>
              {placeholder ? "Publication to come" : item.publication}
            </span>
            <span class="pi__t">{item.title}</span>
          </span>
          <span class="pi__yr">{yearOf(item.date)}</span>
        </Tag>
      </li>
    );
  })}
</ol>
