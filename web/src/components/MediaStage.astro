---
/* The opening: atmosphere before information.
 *
 * A full-bleed stage cycling a short authored sequence — the land, the building
 * in the land, the rooms. No arrows, no dots, no counter; it is ambient, not a
 * carousel. That is the explicit carve-out to R8: it is non-interactive, it
 * pauses off-screen, and it never runs under reduced motion.
 *
 * The clips now come from the CMS rather than from files in the repository, so
 * the most prominent thing on the site is something the practice can change.
 * An empty sequence is a legitimate state — the landing simply has no film in
 * it and every other part of the page is unaffected.
 *
 * Sources stay in data-src so that under reduced motion or Save-Data no video
 * is ever fetched: the still is a designed alternative, not a disabled site.
 * site.js picks which of the two encodings to load from the viewport's shape.
 */
import { getHeroClips } from "../lib/content";
import { requireImage } from "../lib/media";

const clips = await getHeroClips();
---

{clips.length > 0 && (
  <div class="stage" data-stage-frames>
    {clips.map((clip, i) => {
      const poster = clip.poster ? requireImage(clip.poster) : null;
      /* The portrait cut is framed differently from the landscape one, so a
         phone showing the landscape still and then playing the portrait film
         jumps the moment playback starts. Both posters travel with the frame
         and site.js picks the one that matches the encode it is about to
         load. */
      const posterP = clip.posterPortrait ? requireImage(clip.posterPortrait) : null;
      return (
        <figure class="stage__f" data-on={i === 0 ? "true" : "false"} data-label={clip.label}>
          <video
            class="stage__v"
            muted
            loop
            playsinline
            preload={i === 0 ? "auto" : "none"}
            poster={poster?.src}
            data-poster={poster?.src}
            data-poster-portrait={posterP?.src ?? poster?.src}
            data-src={clip.video}
            data-src-portrait={clip.videoPortrait}
          ></video>
        </figure>
      );
    })}
    <p class="stage__label" data-stage-label aria-live="off"></p>
  </div>
)}
