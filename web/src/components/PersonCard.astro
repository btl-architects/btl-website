---
import Figure from "./Figure.astro";
import { coverSizes } from "../lib/media";
import type { Person } from "../lib/content";
interface Props { person: Person }
const { person: p } = Astro.props;
const linked = Boolean(p.slug && p.bio);
const Tag = linked ? "a" : "span";
---
<li class="trow">
  <Tag class="trow__link" href={linked ? `/people/${p.slug}/` : undefined}>
    {p.portrait && <span class="trow__p">
      <Figure image={p.portrait} sizes={coverSizes(p.portrait, "16rem", "50vw")} />
    </span>}
    <span class="trow__n">{p.prefix} {p.name}</span>
    {p.role && <span class="trow__r">{p.role}</span>}
  </Tag>
</li>
