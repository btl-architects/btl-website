---
/* Masthead, primary nav, social rail and the mobile menu.
 *
 * The nav always navigates to a page — never to an anchor on the home page. A
 * menu item that scrolls you somewhere instead of taking you where it says it
 * goes reads as a broken link, not as a clever one-pager. The home page is
 * still a one-pager: you scroll it, but the nav is navigation.
 *
 * The social rail used to be fixed vertical chrome on every page. It came off:
 * three links pinned to the edge of every screen compete with the photographs
 * for attention on a site whose entire argument is the photographs, and they
 * are not what anyone came for. Social lives in the footer and on Contact,
 * where someone looking for it will actually look.
 *
 * Nav and contact are settings content (contract §1 forbids hard-coding any of
 * them), so adding a destination is an edit in the CMS, not a deploy.
 */
import Figure from "./Figure.astro";
import type { Settings } from "../lib/content";
import { LOGO_WHITE } from "../lib/media";

interface Props { settings: Settings; current: string }
const { settings, current } = Astro.props;

/** Settings still carry the prototype's page keys; routes are directories. */
const hrefFor = (key: string) => (key === "index" ? "/" : `/${key}/`);

const logo = LOGO_WHITE;
---

<header class="header" data-over="media">
  <div class="header__inner">
    <a class="header__logo" href="/" aria-label="btl architects — home">
      <Figure image={logo} sizes="(min-width: 48rem) 4.4rem, 3.1rem" eager />
    </a>
    <nav aria-label="Primary">
      <ul class="nav">
        {settings.nav.map((n) => (
          <li>
            <a
              class="nav__link"
              href={hrefFor(n.href)}
              aria-current={n.href === current ? "page" : undefined}
            >{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    {/* One control, not two. It reads "Menu" then "Close" to a screen reader
        via aria-expanded, while visually the two rules rotate into a cross —
        a continuous movement rather than one word being replaced by another. */}
    <button class="burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu">
      <span class="burger__label" data-menu-label>Menu</span>
      <span class="burger__mark" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" data-open="false" role="dialog" aria-modal="true" aria-label="Menu">
  {/* No logo in here. The header's own logo stays visible above the panel, so
      putting a second one at the top of the panel meant the mark slid down and
      landed on top of itself — which is the jarring part. One button too: the
      burger below morphs into a cross rather than being swapped for a
      different control with different words. */}
  <ul class="menu__list">
    {settings.nav.map((n) => (
      <li>
        <a
          class="menu__link"
          href={hrefFor(n.href)}
          aria-current={n.href === current ? "page" : undefined}
        >{n.label}</a>
      </li>
    ))}
  </ul>
  <div class="menu__media"><slot name="menu-media" /></div>
  <div class="menu__foot">
    <address style="font-style:normal" set:html={settings.contact.address.join("<br>")} />
    <a class="tl" href={`tel:${settings.contact.phoneHref}`}>{settings.contact.phone}</a>
  </div>
</div>
