---
import Figure from "./Figure.astro";
import ArticleBody from "./ArticleBody.astro";
import Paragraphs from "./Paragraphs.astro";
import type {Publication, Project} from "../lib/content";
import {articleUrl, frameUrl, sourceName} from "../lib/press";
import {resolveImage} from "../lib/media";
interface Props {item: Publication; project?: Project}
const {item, project} = Astro.props;
const image = item.image ?? (item.useProjectImage ? project?.hook : null);
const original = articleUrl(item.url);
const embed = item.openingMode === "embed" && original?.startsWith("https://");
const managed = item.openingMode === "reader";
const where = sourceName(original, item.publication);
const watch = where === "Instagram";
// The preview photo's shape holds the box until the post reports its own, so
// a first photo shaped like the post (as Instagram's are) means no jump.
const preview = watch && item.articleHero ? resolveImage(item.articleHero) : null;
const previewShape = preview?.width && preview?.height ? `aspect-ratio: ${preview.width} / ${preview.height};` : undefined;
// An embedded post with its own slides is shown as the site's carousel, not
// Instagram's frame: a frame takes the whole of a touch, so on a phone it could
// not both flip slides sideways and let the card move up and down.
const slides = embed ? item.postSlides ?? [] : [];
const firstSlide = slides[0]?._type === "figure" ? resolveImage(slides[0]) : slides[0]?._type === "postVideo" && slides[0].poster ? resolveImage(slides[0].poster) : null;
const railShape = firstSlide?.width && firstSlide?.height ? `aspect-ratio: ${firstSlide.width} / ${firstSlide.height};` : "aspect-ratio: 4 / 5;";
const openingImage = managed ? item.articleHero ?? project?.hook ?? image : image;
const credits = managed ? item.articleCredits : undefined;
const meta = [item.kind === "award" ? "Award" : "Feature", project?.title, item.date?.slice(0, 4)].filter(Boolean).join(" · ");
const readerLabel = item.readerKind === "summary" ? "Article summary" : item.readerKind === "notes" ? "BTL project notes" : null;
const publicationDate = /^\d{4}-\d{2}-\d{2}$/.test(item.date ?? "") && Number.isFinite(Date.parse(item.date))
  ? new Intl.DateTimeFormat("en-GB", {day: "numeric", month: "long", year: "numeric", timeZone: "UTC"}).format(new Date(item.date)) : null;
---
<article class="press-article" data-article-content>
  <header class="press-article__head">
    <p class="press-article__publication">{item.publication}</p>
    <h1>{item.title}</h1>
    <p class="press-article__meta">{meta}</p>
    {item.sourceAuthor && <p class="press-article__source-credit">Original article by {item.sourceAuthor}{publicationDate && <> · <time datetime={item.date}>{publicationDate}</time></>}</p>}
    {managed && readerLabel && <p class="press-article__kind">{readerLabel}</p>}
    {item.byline && managed && <p class="press-article__byline">{item.byline}</p>}
    {item.intro && managed && <Paragraphs text={item.intro} class="press-article__intro" />}
  </header>
  {embed ? (
    <>
      {slides.length > 0 ? (
        <div class="post-rail" data-post-rail>
          <div class="post-rail__track" style={railShape} tabindex="0" role="region" aria-roledescription="carousel"
            aria-label={`${item.title}: ${slides.length} ${slides.length === 1 ? "slide" : "slides"}. Swipe or use the arrow keys.`}>
            {slides.map((slide, i) => (
              <div class="post-rail__slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
                {slide._type === "postVideo"
                  ? <video src={slide.src} poster={slide.poster ? resolveImage(slide.poster)?.src : undefined} controls playsinline preload="none"></video>
                  : <Figure image={slide} fit="contain" sizes="(min-width: 36rem) 33rem, 92vw" priority={i === 0} />}
              </div>
            ))}
          </div>
          {slides.length > 1 && <>
            <button class="post-rail__nav post-rail__nav--prev" type="button" data-step="-1" aria-label="Previous slide" hidden><span aria-hidden="true">‹</span></button>
            <button class="post-rail__nav post-rail__nav--next" type="button" data-step="1" aria-label="Next slide" hidden><span aria-hidden="true">›</span></button>
            <div class="post-rail__dots" aria-hidden="true">{slides.map((_, i) => <i data-on={i === 0 ? "" : undefined}></i>)}</div>
          </>}
        </div>
      ) : watch ? (
        /* An Instagram post, shown as its photographs or video only. The frame
           is Instagram's page: white header and footer around the media. It
           reports its height (press-reader.js), and this box crops to the
           media between them, so there is no inner scrolling and no white. */
        <div class:list={["ig-post", item.articleHero && "ig-post--preview"]} style={previewShape} data-ig-post>
          {/* The post's first photo, from the site's own image delivery: on
              screen at first paint while Instagram's scripts and photos (about
              4 MB) load, then under the post once it fades in. */}
          {item.articleHero
            ? <Figure image={item.articleHero} fit="contain" class="ig-post__preview" sizes="(min-width: 36rem) 33rem, 92vw" priority />
            : <span class="wait" aria-hidden="true"></span>}
          <iframe class="press-article__frame" title={`${item.title}, on ${where}`} data-article-frame={frameUrl(original!)} scrolling="no"
            sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
          <p class="ig-post__failed">This post could not be shown here. <a href={original!} target="_blank" rel="noopener noreferrer">View it on Instagram <span aria-hidden="true">↗</span></a></p>
        </div>
      ) : (
        <>
          <p class="press-article__help">Reading on {where}. If it does not appear, <a href={original!} target="_blank" rel="noopener noreferrer">open it on {where} <span aria-hidden="true">↗</span></a>.</p>
          <iframe class="press-article__frame" title={`Article on ${item.publication}`} data-article-frame={frameUrl(original!)}
            sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </>
      )}
      <noscript><p>Read this article <a href={original!} target="_blank" rel="noopener noreferrer">on {item.publication}</a>.</p></noscript>
    </>
  ) : (
    <>
      {openingImage && <figure class="press-article__image"><Figure image={openingImage} fit="contain" sizes="(min-width: 60rem) 52rem, 92vw" priority />
        {(openingImage.caption || openingImage.credit) && <figcaption>{[openingImage.caption, openingImage.credit].filter(Boolean).join(" · ")}</figcaption>}
      </figure>}
      <ArticleBody blocks={managed ? item.readerContent : []} />
      {credits && <dl class="press-article__credits">
        {credits.architect && <div><dt>Architecture</dt><dd>{credits.architect}</dd></div>}
        {credits.photographer && <div><dt>Photography</dt><dd>{credits.photographer}</dd></div>}
        {credits.collaborators?.length > 0 && <div><dt>With</dt><dd>{credits.collaborators.join(" · ")}</dd></div>}
      </dl>}
    </>
  )}
  {original && <p class="press-article__source"><a href={original} target="_blank" rel="noopener noreferrer">{watch ? `View on ${where}` : `Read the original on ${item.publication}`} <span aria-hidden="true">↗</span></a></p>}
</article>
