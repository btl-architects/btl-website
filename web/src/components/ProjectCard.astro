---
/* One card per line: a wide, shallow photograph strip with the name on it.
 *
 * The card *is* the project. Opening does not summon a second element — the
 * card grows and its own strip starts scrolling, with the cover photograph
 * staying exactly where it is and un-cropping itself as its siblings arrive.
 * Nothing is replaced, so there is nothing to replace it with, and the document
 * only ever grows on open (design memory P10).
 *
 * Several frames are rendered, not one. A single photograph across the full
 * width of a shallow card is a 5:1 crop, which ruins most architectural images
 * and makes every card the same flat letterbox. Six are rendered and the card
 * clips whatever runs past its edge: three fill a laptop, six fill a maximised
 * window, and the clipped frame is the affordance saying it continues.
 *
 * Every data-* attribute here is read by site.js. They are the contract between
 * markup and behaviour — renaming one silently breaks the expansion.
 */
import Figure from "./Figure.astro";
import {peekSizes} from "../lib/media";
import RailNav from "./RailNav.astro";
import type { Project } from "../lib/content";

interface Props { project: Project; priority?: boolean }
const { project, priority = false } = Astro.props;

const peek = project.images.slice(0, 6);
---

<article class="pcard rvc" data-card={project.slug}>
  {/* The link comes first in the source although it is drawn on top of the
      strip (it is absolutely positioned, so order does not move it). It is the
      control that opens the gallery, and what it opens must follow it: with the
      link last, the first Tab after opening left for the next project and the
      photographs and their controls could only be reached going backwards. */}
  <a
    class="pcard__t"
    href={`/projects/${project.slug}/`}
    data-project={project.slug}
    aria-expanded="false"
  >
    <span class="pcard__name">{project.title}</span>
    <span class="pcard__place">{project.location}</span>
  </a>
  {/* Firefox otherwise adds the scroll container itself to the tab order.
      The photographs and their controls already provide keyboard access. */}
  <div class="pcard__strip" data-strip tabindex="-1">
    {peek.map((image, k) => (
      <figure class="rail__f pcard__peek" role="button" tabindex="-1" aria-label={`View photograph ${k + 1}: ${image.alt}`}>
        <Figure image={image} sizes={peekSizes(image)} priority={priority && k === 0} />
      </figure>
    ))}
  </div>
  <RailNav class="pcard__nav" total={project.images.length} name={project.title} hidden>
    {/* A cross, not two words. It sits in a row with a counter, a progress track
        and two arrows; "Close project" was the only thing in it spelled out, and
        it set the row's height. The name is still there for anyone who cannot
        see the mark. */}
    <button class="tl pcard__x" type="button" data-project-close aria-label={`Close ${project.title}`}>×</button>
  </RailNav>
</article>
