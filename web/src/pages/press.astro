---
/* Press and awards — one content type with a `kind`, never two systems.
 *
 * The first version was a masthead wall with the project photograph hidden
 * behind a hover. With one credit that is a page containing a name and a
 * sentence, which is not a page — and hover is a state half the visitors do not
 * have. The recognition means something because of the building that earned it,
 * so the building is on the page rather than one gesture away from it.
 *
 * Each entry is the same spread the rest of the site is built from: photograph
 * one side, type the other, alternating down the page. Where a publication has
 * supplied a logo it is set as the object; where it has not, the name typeset
 * at display scale is the designed fallback and nothing moves when the asset
 * arrives.
 */
import Base from "../layouts/Base.astro";
import Credit from "../components/Credit.astro";
import { getPublications, getProjects, getSettings } from "../lib/content";
import Onward from "../components/Onward.astro";

const copy = (await getSettings()).copy;
const items = await getPublications();
const projects = await getProjects();
const projectFor = (slug: string | null) =>
  slug ? projects.find((p) => p.slug === slug) : undefined;
---

<Base
  title="Press — btl architects"
  description="Where the practice has been published."
  current="press"
>
  <main id="main" data-ground="dark" style="padding-top:var(--header-h)">
    <header class="index-head">
      <h1 class="index-head__t">Press</h1>
      <p class="index-head__s">{copy.pressLead}</p>
    </header>

    <div class="container" style="padding-bottom:var(--space-section)">
      <div class="credits">
        {items.map((item) => (
          <Credit
            item={item}
            project={item.relatedProject ? projectFor(item.relatedProject) : undefined}
          />
        ))}
      </div>

      <Onward href="/projects/" kicker="Next">The work behind the coverage</Onward>
    </div>
  </main>
</Base>
