---
/* Press features and awards share one content type and independent imagery. */
import Base from "../layouts/Base.astro";
import Credit from "../components/Credit.astro";
import { getPublications, getProjects, getSettings } from "../lib/content";
import Onward from "../components/Onward.astro";

const copy = (await getSettings()).copy;
const items = await getPublications();
const projects = await getProjects();
const projectFor = (slug: string | null) =>
  slug ? projects.find((p) => p.slug === slug) : undefined;

/* Prefer the entry's own cover when sharing the page. */
const shareImage = items.map((i) => i.image ?? (i.useProjectImage ? projectFor(i.relatedProject)?.hook : null)).find(Boolean);
---

<Base
  title="Press — btl architects"
  description="Where the practice has been published."
  current="press"
  share={shareImage}
>
  <main id="main" data-ground="dark">
    <header class="index-head rv">
      <h1 class="index-head__t">Press</h1>
      <p class="index-head__s">{copy.pressLead}</p>
    </header>

    <div class="container page-end">
      <div class="credits">
        {items.map((item) => (
          <Credit
            item={item}
            project={item.relatedProject ? projectFor(item.relatedProject) : undefined}
          />
        ))}
      </div>

      <Onward href="/studio/" kicker="Next">The practice behind the coverage</Onward>
    </div>
  </main>
</Base>
