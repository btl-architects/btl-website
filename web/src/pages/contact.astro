---
/* Contact — where the site resolves. Everything needed to reach the studio,
 * stated once.
 *
 * The form posts from the visitor's browser straight to Web3Forms. It used to
 * post to this site's own /api/enquiry, which relayed to Web3Forms from a
 * Cloudflare server — and Web3Forms rate-limits by source IP, so the relay was
 * sharing an outgoing address with a great many other sites and was refused
 * 429 "IP temporarily blocked" on its first real use. From the browser, the
 * address Web3Forms sees is the visitor's own.
 *
 * The access key is therefore in the page, which is how Web3Forms is designed
 * to be used. It is only written into production builds — see enquiryKey() —
 * so a preview or branch build can never send a real email.
 *
 * botcheck is Web3Forms' own honeypot field: a submission with it filled is
 * dropped by Web3Forms before anything is delivered. */
import Base from "../layouts/Base.astro";
import { getSettings } from "../lib/content";
import { enquiryKey } from "../../server/build-mode.js";

const c = (await getSettings()).contact;
const accessKey = enquiryKey(process.env);
---

{/* Dark, like every other page. The white ground was a deliberate idea — the
    site resolving into daylight at the end — but in practice it reads as a
    different website bolted onto the last click, and the form is the one place
    a visitor most needs to feel they are still dealing with the same people. */}
<Base title="Contact — btl architects" description="Talk to the studio." current="contact">
  <main id="main" data-ground="dark">
    <div class="container page-end" style="padding-top:calc(var(--header-h) + var(--s-8))">
      <h1 class="t-h1 rv">Contact</h1>

      <div class="contact__grid">
        <form name="enquiry" method="POST" action="https://api.web3forms.com/submit" class="rv" data-enquiry>
            <input type="hidden" name="access_key" value={accessKey} />
            <input type="hidden" name="subject" value="Enquiry — btldesigns.in" />
            <input type="hidden" name="from_name" value="btldesigns.in" />
          {/* Honeypot. Positioned off-screen rather than display:none, because
              a field that is not rendered is not submitted and the trap stops
              working. Off-screen alone is not enough though: a screen reader
              would happily read it out, and a blind visitor who filled it in
              would have their enquiry silently binned. aria-hidden keeps it out
              of the accessibility tree and tabindex keeps it out of the tab
              order, so only something scraping the DOM ever sees it. */}
          <p class="hp" aria-hidden="true">
            <label>Company <input name="botcheck" tabindex="-1" autocomplete="off" /></label>
          </p>
          <div class="f">
            <label for="n">Name</label>
            <input id="n" name="name" maxlength="120" type="text" autocomplete="name" required />
          </div>
          <div class="f">
            <label for="em">Email</label>
            <input id="em" name="email" maxlength="200" type="email" inputmode="email" autocomplete="email" required />
          </div>
          <div class="f">
            <label for="ph">Phone <span class="muted">(optional)</span></label>
            <input id="ph" name="phone" maxlength="40" type="tel" inputmode="tel" autocomplete="tel" />
          </div>
          <div class="f">
            <label for="ms">Message</label>
            <textarea id="ms" name="message" required minlength="20" maxlength="5000"></textarea>
          </div>
          <button class="b b--solid" type="submit">Send enquiry</button>
          <p data-enquiry-status role="status" aria-live="polite" tabindex="-1"></p>
          <p class="t-caption" style="margin-top:var(--s-4)">
            We use your details to respond to your enquiry. Delivered through Web3Forms.
            Read our <a class="tl" href="/privacy/">privacy notice</a>.
          </p>
        </form>

        <div class="contact__aside rv" data-delay="1">
          <div>
            <span class="eyebrow" style="display:block; color:var(--text-tertiary)">Studio</span>
            <address style="font-style:normal; line-height:1.7">{c.address.map((line) => <>{line}<br /></>)}</address>
          </div>
          <p>
            <a class="tl" href={`mailto:${c.email}`}>{c.email}</a><br />
            <a class="tl" href={`tel:${c.phoneHref}`}>{c.phone}</a>
          </p>
          <p class="t-caption" style="color:var(--text-tertiary)">GSTIN {c.gstin}</p>
        </div>
      </div>
    </div>
  </main>
</Base>

<script src="/scripts/enquiry.js" is:inline defer></script>
