---
/* Studio — the one page where the practice speaks in its own voice.
 *
 * Same spread as People but mirrored, so the two read as a pair rather than as
 * the same page twice: here the statement leads and the photograph answers it.
 * The working method follows as short passages stepping inward across the grid.
 *
 * The photograph is the studio entrance at dusk with the practice's name etched
 * into the glass — which is the single most useful thing this page can show,
 * and it was missing entirely from the first version because the image had
 * never been imported into the CMS.
 */
import Base from "../layouts/Base.astro";
import Figure from "../components/Figure.astro";
import { getHome, getSettings } from "../lib/content";
import Onward from "../components/Onward.astro";
import Statement from "../components/Statement.astro";

const st = (await getHome()).studio;
const settings = await getSettings();
const [lead, ...rest] = st.body;

---

<Base title="Studio — btl architects" description={st.lead} current="studio" share={st.image}>
  <main id="main" data-ground="dark" style="padding-top:var(--header-h)">
    <div class="container page-end">
      <h1 class="sr-only">Studio — btl architects</h1>

      <div class="spread spread--flip" style="margin-top:var(--s-8)">
        {st.image && (
          <div class="spread__media rv">
            <Figure image={st.image} sizes="(min-width:60rem) 34rem, 92vw" priority />
          </div>
        )}
        <div class="spread__body rv" data-delay="1">
          <Statement text={st.lead ?? ""} note={lead} />
        </div>
      </div>

      {rest.length > 0 && (
        <div class="passages">
          {rest.map((para: string, i: number) => (
            <p class="passage t-body rv" data-delay={i % 3}>{para}</p>
          ))}
        </div>
      )}

      {/* Photographs instead of a written method.
          "How a project runs" was four stages in index rows, and the practice
          asked for it out: they would rather show the studio than describe a
          process. The writing above carries as many paragraphs as are added to
          studioBody, and this carries as many photographs as are added to
          studioImages — so the page grows by editing content rather than by
          anyone touching this file again. Empty renders nothing (R15). */}
      {st.images.length > 0 && (
        <section class="studio-plates" style="margin-top:var(--space-section)">
          {st.images.map((img, i) => (
            <figure class="plate rvc" data-delay={i % 3}>
              <Figure image={img} sizes="(min-width:60rem) 46rem, 92vw" />
            </figure>
          ))}
        </section>
      )}

      <Onward href="/people/" kicker="Next">{settings.copy.studioOnward}</Onward>
    </div>
  </main>
</Base>
