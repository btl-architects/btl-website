---
/* Studio — the one page where the practice speaks in its own voice.
 *
 * Same spread as People but mirrored, so the two read as a pair rather than as
 * the same page twice: here the statement leads and the photograph answers it.
 * The working method follows as short passages stepping inward across the grid.
 *
 * The photograph is the studio entrance at dusk with the practice's name etched
 * into the glass — which is the single most useful thing this page can show,
 * and it was missing entirely from the first version because the image had
 * never been imported into the CMS.
 */
import Base from "../layouts/Base.astro";
import Figure from "../components/Figure.astro";
import RailFrame from "../components/RailFrame.astro";
import { spreadSizes } from "../lib/media";
import { getHome, getSettings } from "../lib/content";
import Onward from "../components/Onward.astro";
import Statement from "../components/Statement.astro";

const st = (await getHome()).studio;
const settings = await getSettings();
const [lead, ...rest] = st.body;

---

<Base title="Studio — btl architects" description={st.lead} current="studio" share={st.image}>
  <main id="main" data-ground="dark">
    <div class="container">
      <h1 class="sr-only">Studio — btl architects</h1>

      <div class="spread spread--flip">
        {st.image && (
          <div class="spread__media rv">
            <Figure image={st.image} sizes={spreadSizes(st.image)} priority />
          </div>
        )}
        <div class="spread__body rv" data-delay="1">
          <Statement text={st.lead ?? ""} note={lead} />
        </div>
      </div>

      {rest.length > 0 && (
        <div class="passages">
          {rest.map((para: string, i: number) => (
            <p class="passage t-body rv" data-delay={i % 3}>{para}</p>
          ))}
        </div>
      )}

    </div>

    {/* Photographs instead of a written method.
        "How a project runs" was four stages in index rows, and the practice
        asked for it out: they would rather show the studio than describe a
        process. This carries as many photographs as are added to studioImages,
        so the page grows by editing content. Empty renders nothing (R15).

        A rail, the same one a project's gallery is: photographs at one height
        from the page's edge, running off to the right when there are more than
        fit. They were centred plates in a narrow column, which left a single
        portrait floating in the middle of the screen, lined up with nothing. It
        sits outside .container because a rail is full-bleed by design. */}
    {st.images.length > 0 && (
      <section aria-label="The studio in photographs" style="margin-top:var(--space-section);padding-bottom:var(--s-8)">
        <div class="rail" tabindex="0" role="region" aria-label="Studio photographs — use the arrow keys to browse" data-rail>
          {st.images.map((img, i) => <RailFrame image={img} index={i} />)}
        </div>
        {st.images.length > 1 && (
          <div class="container gallery-controls" aria-label="Photograph navigation">
            <button class="tl" type="button" data-gallery-step="-1">Previous photographs</button>
            <button class="tl" type="button" data-gallery-step="1">Next photographs</button>
          </div>
        )}
      </section>
    )}

    <div class="container page-end">
      <Onward href="/people/" kicker="Next">{settings.copy.studioOnward}</Onward>
    </div>
  </main>
</Base>
