---
/* Not found — offers the way back into the work rather than an apology.
 *
 * The one page on the site allowed to be funny, because it is the only one
 * nobody arrives at on purpose. Everywhere else a joke would be spending the
 * reader's goodwill on the practice's behalf; here there is no goodwill to
 * spend and a dead end to make bearable. The joke is architectural rather than
 * technical — a room that was never built, not an HTTP status — because the
 * reader is on an architect's website and does not care what a 404 is. */
import Base from "../layouts/Base.astro";
import { getProjects, getSettings } from "../lib/content";

const recent = (await getProjects()).slice(0, 3);
const copy = (await getSettings()).copy;
---

<Base title="Not found — btl architects" description="That page does not exist.">
  <main id="main" data-ground="dark">
    <div class="container page-end">
      <h1 class="t-h1">You’ve found a room we never built.</h1>
      <p class="t-lead" style="margin-top:var(--s-5); color:var(--text-secondary); max-width:var(--measure-lead)">
        {copy.notFoundLead}
      </p>
      <ul style="list-style:none; padding:0; margin:var(--s-7) 0 0">
        {recent.map((p) => (
          <li style="margin-top:var(--s-4)">
            <a class="tl t-h3" href={`/projects/${p.slug}/`}>{p.title}</a>
          </li>
        ))}
      </ul>
      <p style="margin-top:var(--s-7)"><a class="tl" href="/">Back to the start</a></p>
    </div>
  </main>
</Base>
