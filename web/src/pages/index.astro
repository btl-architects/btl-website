---
/* The home page is a composition of the site's systems, not imitations of them.
 *
 * The work section runs the same ProjectCard the index runs; press runs the same
 * PressIndex the press page runs. It used to have its own hover-list — a second
 * way of presenting projects that had to be learned separately and then
 * re-learned on /projects.
 *
 * Rhythm alternates release (full-bleed, image-led) and compression (the page
 * stops and speaks) — P5. The order is statement → projects → studio → press →
 * people → contact: the work first, then the practice, then the outside world's
 * verdict, then the faces behind the credibility that verdict just established,
 * and finally the page resolves once into contact.
 */
import Base from "../layouts/Base.astro";
import Statement from "../components/Statement.astro";
import MediaStage from "../components/MediaStage.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Figure from "../components/Figure.astro";
import Onward from "../components/Onward.astro";
import Credit from "../components/Credit.astro";
import { getHome, getProjects, getPublications, getPeople, getSettings } from "../lib/content";

const settings = await getSettings();
const home = await getHome();
const projects = await getProjects();
const featured = projects.filter((p) => p.featured).slice(0, 3);
const work = featured.length ? featured : projects.slice(0, 3);
const press = (await getPublications()).slice(0, 3);
const projectsBySlug = new Map(projects.map((p) => [p.slug, p]));
// The home preview shows the principals only; the full team lives on /people.
const principals = (await getPeople()).filter((p) => p.tier === "principal");
const c = settings.contact;
---

<Base title="btl architects" description={settings.tagline} current="index" ground="media">
  <main id="main">
    <section class="landing" data-ground="media" data-stage>
      <h1 class="sr-only">btl architects — architecture and interiors, Kozhikode</h1>
      <MediaStage />
      {/* The social links come back, but only here — over the opening film,
          where there is nothing else competing and a visitor is still deciding
          what this practice is. They do not follow you down the page. */}
      <nav class="srail" aria-label="btl architects elsewhere">
        {settings.social.map((s) => (
          <a class="srail__i" href={s.url} rel="noopener" target="_blank">{s.label}</a>
        ))}
      </nav>
    </section>

    {/* COMPRESSION — one line, a lot of air */}
    <section class="home-sec home-sec--compress home-sec--midpage" id="statement" data-ground="dark">
      <div class="container">
        <Statement text={home.statement} class="rv" />
      </div>
    </section>

    {/* RELEASE — the work, in the same cards the projects page uses */}
    <section class="home-sec home-sec--release" id="projects" data-ground="dark">
      <div class="container">
        <div class="home-sec__head">
          <h2 class="home-sec__k">Selected work</h2>
        </div>
      </div>
      <div class="pindex" data-pindex>
        {work.map((p) => <ProjectCard project={p} />)}
      </div>
      {/* Below the work, not above it. A visitor who has just scrolled three
          projects needs to be told there are more; a visitor who has not seen
          any yet does not need a link away from them. */}
      <div class="container">
        <Onward href="/projects/" quiet>See every project</Onward>
      </div>
    </section>

    {/* The outside world's verdict, built from the same spread as Studio and
        People — which is the point. It read as a bolted-on widget because it
        was one: a bordered two-column box in the middle of a page that is
        otherwise photograph-and-type spreads. Now it is one of them.

        The magazine's mark overlaps the work it published. That interlock is
        what a "seen in" credit looks like when it means something; set side by
        side with a gap they are just two objects near each other. */}
    {press.length > 0 && (
      <section class="home-sec" id="press" data-ground="dark">
        <div class="container">
          <div class="home-sec__head">
            <h2 class="home-sec__k">Press</h2>
          </div>

          <div class="credits">
            {press.map((item) => (
              <Credit
                item={item}
                project={item.relatedProject ? projectsBySlug.get(item.relatedProject) : undefined}
              />
            ))}
          </div>

          <Onward href="/press/" quiet>Everywhere btl has appeared</Onward>
        </div>
      </section>
    )}

    {/* The practice, in the room it works in. This used to be two paragraphs
        and nothing else — the start of a long text-only run that made the whole
        second half of the page a wall. */}
    <section class="home-sec" id="studio" data-ground="dark">
      <div class="container">
        <div class="home-sec__head">
          <h2 class="home-sec__k">Studio</h2>
        </div>
        <div class="spread spread--flip">
          {home.studio.image && (
            <div class="spread__media rv">
              <Figure image={home.studio.image} sizes="420px" />
            </div>
          )}
          <div class="spread__body rv" data-delay="1">
            <Statement text={home.studio.lead} note={home.studio.body[0]} />
          </div>
        </div>
        <Onward href="/studio/" quiet>How the practice works</Onward>
      </div>
    </section>

    {/* The faces behind the practice the section above just described.
        The founders photograph rather than two portraits, because there are no
        individual portraits — and this frame says more about the practice than
        two headshots would anyway. */}
    <section class="home-sec" id="people" data-ground="dark">
      <div class="container">
        <div class="home-sec__head">
          <h2 class="home-sec__k">People</h2>
        </div>
        <div class="spread">
          {home.founders && (
            <div class="spread__media spread__media--type rv">
              <Figure image={home.founders} sizes="420px" />
              <div class="spread__names">
                {principals.map((p) => (
                  <span>
                    <span class="spread__n">{p.prefix} {p.name}</span>
                    <span class="spread__r">{p.role}</span>
                  </span>
                ))}
              </div>
            </div>
          )}
          {home.peopleLead && (
            <div class="spread__body rv" data-delay="1">
              <Statement text={home.peopleLead} />
            </div>
          )}
        </div>
        <Onward href="/people/" quiet>Everyone at btl</Onward>
      </div>
    </section>

    {/* COMPRESSION — the page resolves */}
    <section class="home-sec home-sec--compress home-sec--closing page-end" id="contact" data-ground="dark">
      <div class="container">
        <div class="home-sec__head">
          <h2 class="home-sec__k">Contact</h2>
        </div>
        <div class="mini mini--2">
          <div class="rv">
            <address
              style="font-style:normal; line-height:1.7; color:var(--text-secondary)"
              set:html={c.address.join("<br>")}
            />
          </div>
          <div class="rv" data-delay="1">
            <p>
              <a class="tl" href={`mailto:${c.email}`}>{c.email}</a><br />
              <a class="tl" href={`tel:${c.phoneHref}`}>{c.phone}</a>
            </p>
          </div>
        </div>
        <Onward href="/contact/" quiet>Send an enquiry</Onward>
      </div>
    </section>
  </main>
</Base>
