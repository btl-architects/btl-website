---
/* The home page is a composition of the site's systems, not imitations of them.
 *
 * The work section runs the same ProjectCard the index runs; press runs the same
 * PressIndex the press page runs. It used to have its own hover-list — a second
 * way of presenting projects that had to be learned separately and then
 * re-learned on /projects.
 *
 * Rhythm alternates release (full-bleed, image-led) and compression (the page
 * stops and speaks) — P5. The order is statement → projects → recognition → people →
 * studio → contact, matching the navigation's People-before-Studio sequence.
 */
import Base from "../layouts/Base.astro";
import Statement from "../components/Statement.astro";
import MediaStage from "../components/MediaStage.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Figure from "../components/Figure.astro";
import { spreadSizes } from "../lib/media";
import Onward from "../components/Onward.astro";
import ContactLinks from "../components/ContactLinks.astro";
import Credit from "../components/Credit.astro";
import {articlePagePath} from "../lib/press";
import { getHome, getProjects, getPublications, getPeople, getSettings } from "../lib/content";

const settings = await getSettings();
const home = await getHome();
const projects = await getProjects();
const featured = projects.filter((p) => p.featured).slice(0, 3);
const work = featured.length ? featured : projects.slice(0, 3);
/* Two on screen, at the practice's request — a pair side by side; three left
   a card stranded under a row of two. Since 2026-11-22 every award and feature
   takes its turn: the pair rotates through all of them, newest date first.

   The rotation swaps whole pairs. With an odd count the last pair would need
   one card in both columns at once, so the list is set twice over; the second
   copy is the same links, never shown at the same time as the first. */
const recognition = await getPublications();
const rotates = recognition.length > 2;
const rotation = rotates && recognition.length % 2 ? [...recognition, ...recognition] : recognition;
const projectsBySlug = new Map(projects.map((p) => [p.slug, p]));
// The home preview shows the principals only; the full team lives on /people.
const principals = (await getPeople()).filter((p) => p.tier === "principal").sort((a,b)=>(a.homeOrder ?? a.order)-(b.homeOrder ?? b.order));
const c = settings.contact;
---

<Base title="btl architects" description={settings.tagline} current="index" ground="media" articleReader={recognition.some(item => articlePagePath(item))}>
  <main id="main" data-under-header>
    <section class="landing" data-ground="media" data-stage>
      <h1 class="sr-only">btl architects — architecture and interiors, Kozhikode</h1>
      <MediaStage />
      {/* Home's social rail stays in the right margin while the page scrolls. */}
      <nav class="srail" aria-label="btl architects elsewhere">
        <div class="srail__links">
          {settings.social.map((s) => (
            <a class="srail__i" href={s.url} rel="noopener" target="_blank">{s.label}</a>
          ))}
        </div>
      </nav>
    </section>

    {/* COMPRESSION — one line, a lot of air */}
    <section class="home-sec home-sec--compress home-sec--midpage" id="statement" data-ground="dark">
      <div class="container">
        <Statement text={home.statement} class="rv statement--scroll" scrollReveal />
      </div>
    </section>

    {/* RELEASE — the work, in the same cards the projects page uses */}
    <section class="home-sec home-sec--release" id="projects" data-ground="dark">
      <div class="container">
        <div class="home-sec__head rv">
          <h2 class="home-sec__k">Selected work</h2>
        </div>
      </div>
      <div class="pindex" data-pindex>
        {work.map((p) => <ProjectCard project={p} />)}
      </div>
      {/* Below the work, not above it. A visitor who has just scrolled three
          projects needs to be told there are more; a visitor who has not seen
          any yet does not need a link away from them. */}
      <div class="container">
        <Onward href="/projects/" quiet>See every project</Onward>
      </div>
    </section>

    {/* Recognition (was Press): the outside world's verdict, built from the same spread as Studio and
        People — which is the point. It read as a bolted-on widget because it
        was one: a bordered two-column box in the middle of a page that is
        otherwise photograph-and-type spreads. Now it is one of them.

        The magazine's mark overlaps the work it published. That interlock is
        what a "seen in" credit looks like when it means something; set side by
        side with a gap they are just two objects near each other. */}
    {recognition.length > 0 && (
      <section class="home-sec" id="recognition" data-ground="dark">
        <div class="container">
          <div class="home-sec__head rv">
            <h2 class="home-sec__k">Recognition</h2>
          </div>

          {/* Every card sits in the same grid row, in one of two columns, so
              the row is always as tall as the tallest card and the page never
              moves while they change. site.js runs the rotation; without it
              the first pair is all that shows. */}
          <div class:list={["credits", rotates && "credits--rotate"]} data-rotate={rotates ? "" : undefined}>
            {rotation.map((item, i) => (
              <div
                class="rot"
                data-slot={i % 2}
                data-rot={!rotates || i < 2 ? "on" : "off"}
                inert={rotates && i >= 2 ? true : undefined}
              >
                <Credit
                  item={item}
                  project={item.relatedProject ? projectsBySlug.get(item.relatedProject) : undefined}
                />
              </div>
            ))}
          </div>

          <Onward href="/recognition/" quiet>Every award and feature</Onward>
        </div>
      </section>
    )}

    {/* The faces behind the practice.
        The founders photograph rather than two portraits, because there are no
        individual portraits — and this frame says more about the practice than
        two headshots would anyway. */}
    <section class="home-sec" id="people" data-ground="dark">
      <div class="container">
        <div class="home-sec__head rv">
          <h2 class="home-sec__k">People</h2>
        </div>
        <div class="spread">
          {home.founders && (
            <div class="spread__media rv">
              <Figure image={home.founders} sizes={spreadSizes(home.founders)} />
              <div class="spread__names">
                {principals.map((p) => (
                  <span>
                    <span class="spread__n">{p.prefix} {p.name}</span>
                    {p.showRoleOnHome && p.role && <span class="spread__r">{p.role}</span>}
                  </span>
                ))}
              </div>
            </div>
          )}
          {home.peoplePreview && (
            <div class="spread__body rv" data-delay="1">
              <Statement text={home.peoplePreview} />
            </div>
          )}
        </div>
        <Onward href="/people/" quiet muted>Everyone at btl</Onward>
      </div>
    </section>

    {/* The practice, in the room it works in. This used to be two paragraphs
        and nothing else — the start of a long text-only run that made the whole
        second half of the page a wall. */}
    <section class="home-sec" id="studio" data-ground="dark">
      <div class="container">
        <div class="home-sec__head rv">
          <h2 class="home-sec__k">Studio</h2>
        </div>
        <div class="spread spread--flip">
          {home.studio.image && (
            <div class="spread__media rv">
              <Figure image={home.studio.image} sizes={spreadSizes(home.studio.image)} />
            </div>
          )}
          {(home.studioPreview.lead || home.studioPreview.note) && (
            <div class="spread__body rv" data-delay="1">
              <Statement text={home.studioPreview.lead} note={home.studioPreview.note} />
            </div>
          )}
        </div>
        {/* Says what is there. It promised "How the practice works" after the
            practice took the written method off the Studio page in favour of
            photographs of the studio, so the link led to a paragraph already
            read here and a set of pictures. */}
        <Onward href="/studio/" quiet>Inside the studio</Onward>
      </div>
    </section>

    {/* COMPRESSION — the page resolves */}
    <section class="home-sec home-sec--compress home-sec--closing page-end" id="contact" data-ground="dark">
      <div class="container">
        <div class="home-sec__head rv">
          <h2 class="home-sec__k">Contact</h2>
        </div>
        <div class="home-contact">
          <div class="rv">
            <address
              style="font-style:normal; line-height:1.7; color:var(--text-secondary)">{c.address.map((line) => <>{line}<br /></>)}</address>
          </div>
          <div class="rv" data-delay="1">
            <ContactLinks contact={c} />
          </div>
        </div>
        <Onward href="/contact/" quiet muted>Send an enquiry</Onward>
      </div>
    </section>
  </main>
</Base>
