---
/* People.
 *
 * The founders photograph is the page and the names sit inside it — the
 * architecture above them is the type field. Paired with the practice
 * statement at display scale, because with two principals and no bios yet
 * there is not enough prose to carry a page on its own, and pretending
 * otherwise is what made the first version of this read as unfinished.
 *
 * Everything below the spread is conditional. Bios appear when they are
 * written, the team list when there are real names, alumni when someone
 * leaves. The composition does not change when any of that happens — it just
 * gets longer.
 */
import Base from "../../layouts/Base.astro";
import Figure from "../../components/Figure.astro";
import { getPeople, getHome, getSettings } from "../../lib/content";

const people = await getPeople();
const principals = people.filter((p) => p.tier === "principal");
const team = people.filter((p) => p.tier === "team");
const alumni = people.filter((p) => p.tier === "alumni");

const home = await getHome();
const copy = (await getSettings()).copy;
// The founders photograph is settings content, not a file: the practice can
// replace it the day they have a better frame, without anyone touching code.
const founders = home.founders;
const withBios = principals.filter((p) => p.bio);

/* Short enough to be a statement, or long enough to be a paragraph? The scale
   follows the writing rather than the writing being forced to fit a scale. */
const say = (t: string) =>
  t.trim().split(/\s+/).length <= 16 ? "spread__say--display" : "spread__say--lead";
---

<Base
  title="People — btl architects"
  description="The people behind btl architects."
  current="people"
>
  <main id="main" data-ground="dark" style="padding-top:var(--header-h)">
    <div class="container" style="padding-bottom:var(--space-section)">
      <h1 class="sr-only">People — btl architects</h1>

      <div class="spread" style="margin-top:var(--s-8)">
        {founders && (
          <div class="spread__media spread__media--type rv">
            <Figure image={founders} sizes="(min-width:60rem) 34rem, 92vw" priority />
            <div class="spread__names">
              {principals.map((p) => (
                <span>
                  <span class="spread__n">{p.prefix} {p.name}</span>
                  <span class="spread__r">{p.role}</span>
                </span>
              ))}
            </div>
          </div>
        )}

        <div class="spread__body rv" data-delay="1">
          <p class:list={["spread__say", say((home.peopleLead ?? "")) ]}>{home.peopleLead}</p>
        </div>
      </div>

      {withBios.length > 0 && (
        <section class="roster">
          <h2 class="eyebrow roster__k">The principals</h2>
          {withBios.map((p, i) => (
            <p class="bio rv" data-delay={i}>
              {/* The name carries the link to the full profile. Without this the
                  profile page exists and nothing on the site reaches it. */}
              {p.slug
                ? <a class="bio__n ul" href={`/people/${p.slug}/`}>{p.prefix} {p.name}</a>
                : <span class="bio__n">{p.prefix} {p.name}</span>}
              {p.bio}
            </p>
          ))}
        </section>
      )}

      {team.length > 0 && (
        <section class="roster team">
          <h2 class="eyebrow roster__k">The team</h2>
          <ul class="team__list">
            {team.map((p) => (
              <li class="trow">
                {/* A row is only a link where there is a page worth reaching. */}
                {p.slug && p.bio ? (
                  <a class="trow__link" href={`/people/${p.slug}/`}>
                    {p.portrait && (
                      <span class="trow__p">
                        <Figure image={p.portrait} sizes="(min-width:60rem) 20rem, 3rem" />
                      </span>
                    )}
                    <span class="trow__n">{p.prefix} {p.name}</span>
                    <span class="trow__r">{p.role}</span>
                  </a>
                ) : (
                  <span class="trow__link">
                    {p.portrait && (
                      <span class="trow__p">
                        <Figure image={p.portrait} sizes="(min-width:60rem) 20rem, 3rem" />
                      </span>
                    )}
                    <span class="trow__n">{p.prefix} {p.name}</span>
                    <span class="trow__r">{p.role}</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}

      {alumni.length > 0 && (
        <section class="roster team">
          <h2 class="eyebrow roster__k">Previously at btl</h2>
          <ul class="team__list">
            {alumni.map((p) => (
              <li class="trow">
                <span class="trow__link">
                  <span class="trow__n">{p.prefix} {p.name}</span>
                  <span class="trow__r">{p.role}</span>
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <a class="onward ul" href="/projects/">
        <span class="onward__k">Next</span>
        {copy.peopleOnward}
      </a>
    </div>
  </main>
</Base>
