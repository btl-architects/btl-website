---
/* People has its own team photograph; Home retains the founders. */
import Base from "../../layouts/Base.astro";
import Figure from "../../components/Figure.astro";
import { spreadSizes } from "../../lib/media";
import PersonCard from "../../components/PersonCard.astro";
import { getPeople, getHome, getSettings } from "../../lib/content";
import Onward from "../../components/Onward.astro";
import Statement from "../../components/Statement.astro";

const people = await getPeople();
const team = people.filter((p) => p.tier === "team" || p.tier === "principal" && p.showInTeam !== false);
const alumni = people.filter((p) => p.tier === "alumni");

const home = await getHome();
const copy = (await getSettings()).copy;
const teamImage = home.teamImage;

---

<Base
  title="People — btl architects"
  description="The people behind btl architects."
  current="people"
  share={teamImage}
>
  <main id="main" data-ground="dark">
    <div class="container page-end">
      <h1 class="sr-only">People — btl architects</h1>

      <div class="spread">
        {teamImage && (
          <div class="spread__media rv">
            <Figure image={teamImage} sizes={spreadSizes(teamImage)} priority />
          </div>
        )}

        {home.peopleLead && (
          <div class="spread__body rv" data-delay="1">
            <Statement text={home.peopleLead} />
          </div>
        )}
      </div>

      {team.length > 0 && (
        <section class="roster team">
          <h2 class="eyebrow roster__k rv">The team</h2>
          <ul class="team__list">
            {team.map((person) => <PersonCard person={person} />)}
          </ul>
        </section>
      )}

      {alumni.length > 0 && (
        <section class="roster team">
          <h2 class="eyebrow roster__k rv">Previously at btl</h2>
          <ul class="team__list">
            {alumni.map((person) => <PersonCard person={person} />)}
          </ul>
        </section>
      )}

      <Onward href="/contact/" kicker="Next">{copy.peopleOnward}</Onward>
    </div>
  </main>
</Base>
