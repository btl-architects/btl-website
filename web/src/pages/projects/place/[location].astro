---
/* Place routes. Same reserved-segment reasoning as `type`. */
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import ProjectIndex from "../../../components/ProjectIndex.astro";
import { getLocations, getProjects } from "../../../lib/content";

export const getStaticPaths = (async () => {
  const [locations, projects] = await Promise.all([getLocations(), getProjects()]);
  return locations.map((l) => ({
    params: { location: l.slug },
    props: { place: l, projects: projects.filter((p) => p.locationSlug === l.slug) },
  }));
}) satisfies GetStaticPaths;

const { place, projects } = Astro.props;
---

<Base
  title={`${place.label} — btl architects`}
  description={`Work by btl architects in ${place.label}.`}
  current="projects"
>
  <ProjectIndex projects={projects}
    title={place.label} />
</Base>
