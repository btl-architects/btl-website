---
/* A project's own page.
 *
 * This is the source of truth for a project's photographs. The index does not
 * duplicate them — it fetches this page and lifts the rail out, so the markup
 * exists once and the index works with JavaScript off.
 */
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import ProjectRail from "../../components/ProjectRail.astro";
import { getProjects } from "../../lib/content";
import Onward from "../../components/Onward.astro";

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      // Wraps around, so the pager is never a dead end at either end.
      prev: projects[(i - 1 + projects.length) % projects.length]!,
      next: projects[(i + 1) % projects.length]!,
    },
  }));
}) satisfies GetStaticPaths;

const { project, prev, next } = Astro.props;
---

<Base
  title={`${project.title} — btl architects`}
  description={project.description.slice(0, 155) || `${project.title}, ${project.location} — btl architects.`}
  current="projects"
  share={project.hook}
>
  <main id="main" data-ground="dark" class="pj">
    <article>
      {/* On its own page the rail has no index row above it, so the project
          names itself here. Same information, stated once. */}
      {/* The project's own page needs a real <h1>, and this is the visible
          title, so it is the heading rather than a styled span with a
          screen-reader-only duplicate hidden elsewhere. A <span> cannot legally
          wrap an <h1>, so the row is a <div>. */}
      <header class="pj__head">
        <div class="pjh__id grid12">
          <h1 class="pjh__name">{project.title}</h1>
          <span class="pjh__place">{project.location}</span>
        </div>
      </header>

      <ProjectRail project={project} priority />

      <div class="container page-end">
        <nav class="pager" style="margin-top:var(--s-8)" aria-label="Projects">
          <a href={`/projects/${prev.slug}/`}>
            <span class="pager__k">Previous</span>
            <span class="pager__n">{prev.title}</span>
          </a>
          <a class="pager__r" href={`/projects/${next.slug}/`}>
            <span class="pager__k">Next</span>
            <span class="pager__n">{next.title}</span>
          </a>
        </nav>
        <Onward href="/projects/" kicker="Back">Every project</Onward>
      </div>
    </article>
  </main>
</Base>
