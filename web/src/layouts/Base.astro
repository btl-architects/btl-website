---
/* The page shell. Every route renders through this and no route writes its own
 * <head>, so the font preload, the token order and the skip link cannot drift
 * apart between pages.
 *
 * The three stylesheets are imported in cascade order — tokens define the
 * vocabulary, base sets the elements, components build on both. That order is
 * load-bearing; it is not alphabetical by accident.
 */
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSettings, getHome } from "../lib/content";
import { isPreview, isNoindex } from "../lib/sanity";
import { socialImage, ZOOM_LADDER, type SiteImage } from "../lib/media";
import {pageSearchListing, searchMetadata, businessStructuredData, jsonLd, type SearchListing} from "../lib/seo";

interface Props {
  title: string;
  description: string;
  /** Optional metadata only; never used for visible writing or headings. */
  seo?: SearchListing;
  /** Which nav item is the current page, by its settings href key. */
  current?: string;
  /** Body-level ground, so the header knows what it is sitting on. */
  ground?: "dark" | "light" | "media";
  /** Keep this page out of search results. For pages that are a step in a
   *  process rather than a destination — a thank-you page has nothing to offer
   *  someone arriving from a search, and ranking it would be a small
   *  embarrassment on a practice's own name. */
  noindex?: boolean;
  /** The photograph a shared link should show. Falls back to the founders, so
   *  no page can be shared as a bare text card by omission. */
  share?: SiteImage | null;
  articleReader?: boolean;
  article?: {date: string; author: string; authorType?: "Person" | "Organization"; headline?: string; publisher?: string; source?: string};
}

const { title: fallbackTitle, description: fallbackDescription, seo, current = "", ground = "dark", noindex = false, share, articleReader = false, article } = Astro.props;
const settings = await getSettings();
const {title, description} = searchMetadata({
  title: Astro.url.pathname === "/" ? `${settings.name} — Architecture & Interiors, Kozhikode` : fallbackTitle,
  description: fallbackDescription,
}, seo ?? pageSearchListing(Astro.url.pathname, settings.pageSeo));
const canonical = new URL(Astro.url.pathname === "/404/" ? "/404.html" : Astro.url.pathname, Astro.site).href;

/* A shared link is the practice's front door more often than the home page is.
 * The fallback matters more than the parameter: a route that forgets to pass a
 * photograph still shares as a photograph, because the failure mode of getting
 * this wrong is invisible from inside the site — everything looks fine until
 * somebody sends the link to a client. */
const home = await getHome();
const shareImage = socialImage(share ?? home.founders ?? home.studio.image);
const shareAlt = (share ?? home.founders ?? home.studio.image)?.alt ?? settings.name;

/* The business is the same entity on every page. Its image comes from the
 * practice rather than whichever project happens to be shared. */
const origin = Astro.site?.href ?? new URL('/', canonical).href;
const org = businessStructuredData(settings, origin, socialImage(home.founders ?? home.studio.image));
const website = Astro.url.pathname === "/" ? {
  "@context": "https://schema.org", "@type": "WebSite",
  "@id": new URL('#website', origin).href, name: settings.name, url: origin,
  publisher: {"@id": org['@id']},
} : null;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    {(isNoindex || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {article?.date && <meta property="article:published_time" content={article.date} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:locale" content="en_IN" />
    {shareImage && (
      <>
        {/* The dimensions are stated because several platforms will not render
            a preview large until they have fetched the file and measured it —
            saying so up front is the difference between a photograph and a
            thumbnail on the first share, which is the one that matters. */}
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={shareAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={shareImage} />
      </>
    )}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {/* The mark, at the sizes that are actually asked for. SVG first for
        anything modern, the PNG for Safari and for a phone home screen. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link
      rel="preload"
      href="/assets/fonts/Satoshi-Latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={jsonLd(org)} is:inline />
    {website && <script type="application/ld+json" set:html={jsonLd(website)} is:inline />}
    {article && <script type="application/ld+json" set:html={jsonLd({
      "@context": "https://schema.org", "@type": "Article", headline: article.headline ?? title,
      description, mainEntityOfPage: canonical,
      ...(article.date ? {datePublished: article.date} : {}),
      author: {"@type": article.authorType ?? "Organization", name: article.author},
      publisher: {"@type": "Organization", name: article.publisher ?? settings.name},
      ...(shareImage ? {image: [shareImage]} : {}),
      ...(article.source ? {citation: article.source} : {}),
    })} is:inline />}
  </head>
  <body id="top" data-ground={ground} data-preview={isPreview ? "true" : undefined} data-zoom-widths={ZOOM_LADDER.join(",")}>
    <a class="skip" href="#main">Skip to content</a>
    {/* Unmissable, because the most expensive mistake with a preview build is
        not realising you are looking at one. */}
    {isPreview && (
      <p class="preview-flag">
        Preview — showing unpublished drafts. This is not the live site.
      </p>
    )}
    <Header settings={settings} current={current} />
    <slot />
    <Footer settings={settings} current={current} />
    <script src="/scripts/site.js" is:inline defer></script>
    {(articleReader || current === "press") && <script src="/scripts/press-reader.js" is:inline defer></script>}
  </body>
</html>
