---
/* The page shell. Every route renders through this and no route writes its own
 * <head>, so the font preload, the token order and the skip link cannot drift
 * apart between pages.
 *
 * The three stylesheets are imported in cascade order — tokens define the
 * vocabulary, base sets the elements, components build on both. That order is
 * load-bearing; it is not alphabetical by accident.
 */
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getSettings, getHome } from "../lib/content";
import { isPreview } from "../lib/sanity";
import { socialImage, type SiteImage } from "../lib/media";

interface Props {
  title: string;
  description: string;
  /** Which nav item is the current page, by its settings href key. */
  current?: string;
  /** Body-level ground, so the header knows what it is sitting on. */
  ground?: "dark" | "light" | "media";
  /** Keep this page out of search results. For pages that are a step in a
   *  process rather than a destination — a thank-you page has nothing to offer
   *  someone arriving from a search, and ranking it would be a small
   *  embarrassment on a practice's own name. */
  noindex?: boolean;
  /** The photograph a shared link should show. Falls back to the founders, so
   *  no page can be shared as a bare text card by omission. */
  share?: SiteImage | null;
}

const { title, description, current = "", ground = "dark", noindex = false, share } = Astro.props;
const settings = await getSettings();
const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* A shared link is the practice's front door more often than the home page is.
 * The fallback matters more than the parameter: a route that forgets to pass a
 * photograph still shares as a photograph, because the failure mode of getting
 * this wrong is invisible from inside the site — everything looks fine until
 * somebody sends the link to a client. */
const home = await getHome();
const shareImage = socialImage(share ?? home.founders ?? home.studio.image);
const shareAlt = (share ?? home.founders ?? home.studio.image)?.alt ?? settings.name;

/* Who and where, for the search engines. A practice that comes up as a proper
 * business panel for "architects in Kozhikode" is worth more to btl than any
 * amount of the design above it, and none of this is visible on the page. */
const org = {
  "@context": "https://schema.org",
  "@type": "ArchitecturalService",
  name: settings.name,
  url: Astro.site?.href ?? canonical,
  ...(shareImage ? { image: shareImage } : {}),
  ...(settings.tagline ? { description: settings.tagline } : {}),
  address: {
    "@type": "PostalAddress",
    streetAddress: settings.contact.address.slice(0, -1).join(", "),
    addressLocality: "Kozhikode",
    addressRegion: "Kerala",
    addressCountry: "IN",
  },
  ...(settings.contact.phone ? { telephone: settings.contact.phone } : {}),
  ...(settings.contact.email ? { email: settings.contact.email } : {}),
  /* sameAs is a claim that these accounts ARE this practice, so a placeholder
   * must never reach it. The social links currently point at the bare domains
   * — linkedin.com/ with no profile after it — which would tell Google the
   * practice owns LinkedIn. A URL only counts once it has a path. */
  ...(() => {
    const profiles = settings.social
      .map((s) => s.url)
      .filter((u): u is string => {
        if (!u) return false;
        try { return new URL(u).pathname.replace(/\/+$/, "").length > 0; }
        catch { return false; }
      });
    return profiles.length ? { sameAs: profiles } : {};
  })(),
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    {(isPreview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:locale" content="en_IN" />
    {shareImage && (
      <>
        {/* The dimensions are stated because several platforms will not render
            a preview large until they have fetched the file and measured it —
            saying so up front is the difference between a photograph and a
            thumbnail on the first share, which is the one that matters. */}
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={shareAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={shareImage} />
      </>
    )}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {/* The mark, at the sizes that are actually asked for. SVG first for
        anything modern, the PNG for Safari and for a phone home screen. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link
      rel="preload"
      href="/assets/fonts/Satoshi-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script type="application/ld+json" set:html={JSON.stringify(org)} is:inline />
  </head>
  <body id="top" data-ground={ground} data-preview={isPreview ? "true" : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    {/* Unmissable, because the most expensive mistake with a preview build is
        not realising you are looking at one. */}
    {isPreview && (
      <p class="preview-flag">
        Preview — showing unpublished drafts. This is not the live site.
      </p>
    )}
    <Header settings={settings} current={current} />
    <slot />
    <Footer settings={settings} />
    <script src="/scripts/site.js" is:inline defer></script>
  </body>
</html>
