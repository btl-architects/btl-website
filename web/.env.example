SANITY_PROJECT_ID=
SANITY_DATASET=production
# Leave empty for the current Pages address; set after connecting a custom domain.
SITE_URL=
# Optional public Web3Forms key. Production only; never a mail-provider secret.
ENQUIRY_ACCESS_KEY=
# Draft previews only, on an authenticated Cloudflare preview or local machine.
SANITY_PREVIEW=false
SANITY_PREVIEW_TOKEN=
# Configure these as Cloudflare runtime variables, not public content.
PREVIEW_USERNAME=preview
PREVIEW_PASSWORD=
