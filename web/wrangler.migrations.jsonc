// Used ONLY to apply D1 migrations to the production database:
//   npm run db:remote
//
// Deliberately not named wrangler.jsonc. On Cloudflare Pages a file with that
// exact name in the project root becomes the project's configuration, and the
// dashboard's bindings and variables turn read-only — which would quietly
// displace the Sanity variables the build depends on. The binding itself lives
// in the dashboard (Settings → Bindings → D1, name ENQUIRY_DB). This file just
// tells wrangler which database the migrations belong to.
//
// The database id is an identifier, not a credential: using it still requires
// an authenticated Cloudflare account.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btl-migrations",
  "compatibility_date": "2026-09-20",
  "d1_databases": [
    {
      "binding": "ENQUIRY_DB",
      "database_name": "btl-enquiries",
      "database_id": "b6798447-d017-4f07-a25f-65122b4f5f48",
      "migrations_dir": "migrations"
    }
  ]
}
